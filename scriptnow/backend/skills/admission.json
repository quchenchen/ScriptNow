      "script-voice-craft": {
        "status": "admitted",
        "baseline": "script-skill-baseline-v1",
        "cases": {
          "positive": {
            "prompt": "为复仇短剧的第3集写一段对白，要求两个角色对话语气截然不同",
            "assert": "台词遮住名字可区分说话人，无AI禁止词汇"
          },
          "negative": {
            "prompt": "写一段角色介绍：他是XX集团总裁，冷峻无情",
            "assert": "无简历式介绍、无模板化描述"
          },
          "regression": {
            "prompt": "写一集女频重生短剧的对白",
            "assert": "三人以上对话可区分说话人，情绪通过行为呈现"
          }
        }
      },
      "script-character-depth": {
        "status": "admitted",
        "baseline": "script-skill-baseline-v1",
        "cases": {
          "positive": {
            "prompt": "为一个复仇者角色设计矛盾特质和私密习惯",
            "assert": "包含至少一对矛盾特质和一个具体私密习惯"
          },
          "negative": {
            "prompt": "写一个反派角色，他心狠手辣冷酷无情",
            "assert": "不出现'表面冷酷内心温柔'模板"
          },
          "regression": {
            "prompt": "写一集都市短剧，让两个旧情人在咖啡馆偶遇",
            "assert": "两人之间存在不对等的认知差"
          }
        }
      },
      "script-plot-causality": {
        "status": "admitted",
        "baseline": "script-skill-baseline-v1",
        "cases": {
          "positive": {
            "prompt": "为短剧第5集写一段情节，确保每事件有前因后果和角色反应",
            "assert": "每个事件满足因果三要素"
          },
          "negative": {
            "prompt": "主角突然获得了超能力，没人知道为什么",
            "assert": "无因事件被拒绝或标记"
          },
          "regression": {
            "prompt": "写一集女频重生短剧，检查巧合使用是否超标",
            "assert": "巧合仅制造问题不解决问题，5集内不超过1次"
          }
        }
      },
      "script-scene-sensory": {
        "status": "admitted",
        "baseline": "script-skill-baseline-v1",
        "cases": {
          "positive": {
            "prompt": "为短剧设计一个办公室场景，包含感官锚点和空间调度",
            "assert": "至少2个不同通道的感官细节，角色位置关系明确"
          },
          "negative": {
            "prompt": "场景：一个富丽堂皇的大厅",
            "assert": "无具体感官细节"
          },
          "regression": {
            "prompt": "设计一个重复出现的场景，第三次出现时的情绪变化",
            "assert": "情绪签名有明确偏离或强化"
          }
        }
