# Copy this file to deploy.env and keep deploy.env outside version control.
BIND_ADDRESS=127.0.0.1
PORT=18090
SCRIPTNOW_ENVIRONMENT=production
SCRIPTNOW_COOKIE_SECURE=true

# Generate each value independently with: openssl rand -hex 32
SCRIPTNOW_ACCESS_TOKEN_SECRET=replace-with-a-random-secret-at-least-24-characters
SCRIPTNOW_CREDENTIAL_MASTER_KEY=replace-with-a-random-secret-at-least-32-characters

# Source-distillation performance tuning. Extraction runs concurrent bounded model
# calls; set DISTILLATION_EXTRACT_MODEL_ID to a faster/cheaper model (e.g. flash)
# when quality allows. Leave empty to keep the reviewer template default model.
SCRIPTNOW_DISTILLATION_EXTRACT_CONCURRENCY=3
SCRIPTNOW_DISTILLATION_EXTRACT_MODEL_ID=

# Official registries are the portable defaults.
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
DEBIAN_MIRROR=

# Mainland China build acceleration (enable only when the mirrors are reachable):
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
