{
  "name": "scriptnow-frontend",
  "private": true,
  "version": "0.2.0-rc.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @scriptnow/creator && npm run build --workspace @scriptnow/admin",
    "test": "vitest run",
    "dev:creator": "npm run dev --workspace @scriptnow/creator",
    "dev:admin": "npm run dev --workspace @scriptnow/admin"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.12.1",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.39",
    "vue-router": "^5.0.4"
  }
}
