# === Required in production ===

# JWT signing secret. Any random string >= 32 bytes.
# In production, MUST be set. Backend will refuse to start otherwise (after issue #04).
JWT_SECRET=dev-secret-only-for-local-testing-do-not-use-in-prod-xxxxxx

# === LLM providers (at least one required) ===

# 阿里云百炼 (推荐 for 国内)
DASHSCOPE_API_KEY=

# DeepSeek (直连)
DEEPSEEK_API_KEY=

# OpenAI (需科学上网)
OPENAI_API_KEY=

# Anthropic (需科学上网)
ANTHROPIC_API_KEY=

# === Optional ===

# Override default DB path
# SCRIPTFLOW_DB_PATH=./data/scriptflow.db

# Default model when client doesn't specify
# SCRIPTFLOW_DEFAULT_MODEL=dashscope:deepseek-v4-pro
